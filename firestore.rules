rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isPublishedBusiness() {
      return resource.data.status == 'published';
    }

    match /businesses/{businessId} {
      allow read: if isPublishedBusiness();
      allow create, update, delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true;
      allow create, update, delete: if false;
    }

    match /certificationBodies/{bodyId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /amenityTaxonomy/{amenityId} {
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /slugs/{slug} {
      allow read, create, update, delete: if false;
    }

    function isPublishedMosque() {
      return resource.data.status == 'published';
    }

    match /mosques/{mosqueId} {
      allow read: if isPublishedMosque();
      // Writes are gated to the Admin SDK (Server Actions) — Firestore rules
      // never permit client writes; the admin allowlist runs server-side.
      allow create, update, delete: if false;
    }

    match /geocodeCache/{cacheId} {
      allow read, create, update, delete: if false;
    }

    match /favoriteStats/{statsId} {
      // Public read so signed-out visitors see the like count next to ayahs.
      // Writes only via server actions (Admin SDK bypasses these rules).
      allow read: if true;
      allow create, update, delete: if false;
    }

    match /businessReports/{reportId} {
      // Reports are submitted through /api/businesses/report → the Admin SDK
      // (submitBusinessReportAction), which bypasses these rules. No client path
      // writes here directly, so deny all client access — this closes the
      // previous anonymous, unauthenticated, unbounded create vector (report
      // spam) with no impact on the app.
      allow read, create, update, delete: if false;
    }

    // i-muslim Quran app — each signed-in user can read/write only their own backup.
    match /quran_backups/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
